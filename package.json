{
  "name": "voice-training",
  "private": true,
  "author": "princess-pixels",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "build:binary": "bun scripts/build-binary.ts",
    "start": "bun src/cli.ts",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync && bun scripts/i18n.ts || echo ''",
    "typecheck": "svelte-kit sync && bun scripts/i18n.ts && svelte-check --tsconfig ./tsconfig.json && bun check scripts",
    "test": "bun scripts/i18n.ts && bun test",
    "coverage:gap": "bun scripts/coverage-gap.ts",
    "import": "bun scripts/import.ts",
    "i18n": "bun scripts/i18n.ts",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.4.5",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.6"
  }
}
