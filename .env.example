# Port the app listens on (production build only; `bun run dev` uses 5173)
PORT=3000

# The URL you open the app at (production build only). SvelteKit compares the
# browser's Origin header against this when a recording is uploaded; if it is
# unset, the Bun adapter assumes https and every save fails with a 403 on plain
# http. Behind a TLS proxy, set it to the public https URL instead.
ORIGIN=http://localhost:3000

# Largest request body the production server accepts. The adapter's default is
# 512K, which rejects any recording longer than a couple of minutes with a 413
# before the upload route can run. The route itself caps audio at 50 MB; 64M
# leaves room for the pitch points and multipart overhead on top of that.
BODY_SIZE_LIMIT=64M

# Where the SQLite database and the recordings live. Relative paths resolve
# against the working directory. Default: ./data for `bun run dev` / `bun
# ./build/index.js`; the single binary defaults to your user data folder.
DATA_DIR=./data

# Address to bind. The binary defaults to 127.0.0.1; the adapter to 0.0.0.0.
# HOST=127.0.0.1

# Binary only: open the browser on start (default on). Set 0 for a service.
# OPEN=0
